# Copy to .env and adjust. PROXY_PASSWORD_HASH has no safe default — generate it.
#   cp .env.example .env
#   ../../scripts/gen-proxy-auth.sh 'your-strong-password'
# then paste the printed PROXY_* lines into .env

# Caddy image tag — pinned for reproducibility, bump deliberately
CADDY_IMAGE_TAG=2.11.4-alpine

# Host port the proxy is published on (single entrypoint for all backends)
PROXY_HOST_PORT=8080

# HTTP Basic Auth username
PROXY_USER=freki

# bcrypt hash for PROXY_USER (NOT the plaintext password).
# Each literal $ must be written as $$ so Docker Compose does not eat it.
# Example below is the Caddy docs lab hash for password "hiccup" — replace it.
#   ../../scripts/gen-proxy-auth.sh
PROXY_PASSWORD_HASH=$$2a$$14$$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG

# Upstream backends (host:port as seen from the proxy container).
# Default uses host.docker.internal + host-gateway (Linux) so this compose
# project does not need to share networks with ollama/vllm/comfyui.
# Point these at wherever the services actually listen.
OLLAMA_UPSTREAM=host.docker.internal:11434
VLLM_UPSTREAM=host.docker.internal:8000
COMFYUI_UPSTREAM=host.docker.internal:8188
