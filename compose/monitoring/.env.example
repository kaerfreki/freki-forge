# Copy to .env and adjust. Every value has a working default.

# --- Image tags (pinned for reproducibility; bump deliberately) ---
PROMETHEUS_IMAGE_TAG=v3.13.1
GRAFANA_IMAGE_TAG=13.1.1
NVIDIA_GPU_EXPORTER_IMAGE_TAG=1.13.1

# --- Host ports ---
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
# Optional: raw GPU exporter for curl/debug (Prometheus scrapes in-network)
NVIDIA_GPU_EXPORTER_HOST_PORT=9835

# --- Prometheus TSDB ---
PROMETHEUS_RETENTION=15d

# --- Grafana login (change on any shared host) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
